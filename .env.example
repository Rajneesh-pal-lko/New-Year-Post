# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- App -------------------------------------------------------------------
# production | staging | development. Anything other than "production" enables
# the test overrides below. If unset, the app behaves as production.
APP_ENV=development
# Public base URL, no trailing slash. Used in emails and WhatsApp share links.
APP_BASE_URL=http://localhost:3000

# --- Supabase (server only) -------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role / secret key. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---------------------------------------------------------------
# Use rzp_test_... keys until live activation is approved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# --- Tokens -----------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`. Must be IDENTICAL here and
# in the Supabase Edge Function secrets. Rotating it breaks every existing
# recipient and order link, so set it once before launch.
TOKEN_SECRET=

# --- Cron -------------------------------------------------------------------
# Shared secret sent by Supabase Cron (pg_net) to /api/cron/reconcile and to
# the deliver Edge Function. `openssl rand -hex 32`.
CRON_SECRET=

# --- Email provider (Resend) ---------------------------------------------------
# Signing secret of the Resend webhook (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# Only needed by the Next.js app for the admin "run delivery now" button.
SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# --- Admin ------------------------------------------------------------------
ADMIN_USER=admin
# Long random password. The /admin area uses HTTP Basic auth over HTTPS.
ADMIN_PASSWORD=

# --- Checkout ---------------------------------------------------------------
# Minutes a price snapshot is honoured before the checkout expires.
CHECKOUT_TTL_MINUTES=15

# --- Test overrides (ignored when APP_ENV=production) --------------------------
# Pretend the server clock is this IST time, for testing price tiers and the
# sales window. Format: 2026-12-08T09:30
# CLOCK_OVERRIDE_IST=
# Deliver on this date instead of 2027-01-01, for staging rehearsals. Format: 2026-12-15
# DELIVERY_DATE_OVERRIDE=
